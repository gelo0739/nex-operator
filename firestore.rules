rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOperator() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operator';
    }

    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Operators only manage data on their own bus line.
    function operatorOnLine(line) {
      return isOperator() && line == callerProfile().line;
    }

    // Routes: every signed-in user (commuters, conductors) can view them;
    // only an operator of the route's line can create, edit or delete it.
    match /routes/{routeId} {
      allow read: if signedIn();
      allow create: if operatorOnLine(request.resource.data.line);
      allow update: if operatorOnLine(resource.data.line)
        && request.resource.data.line == resource.data.line;
      allow delete: if operatorOnLine(resource.data.line);
    }

    // Legal documents (Terms & Conditions, Privacy Policy): readable by anyone,
    // signed in or not (the NEX sign-up screen shows them). Published with the
    // Admin SDK (nex-operator scripts/seedLegalDocuments.mjs) — no client writes.
    match /legalDocuments/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // users/{uid}.legalAcceptance = { <docId>: { version, acceptedAt } } —
    // which version of each legal document the user accepted, and when
    // (server time). An entry may only change to a valid, freshly-timestamped
    // acceptance; entries can't be back-dated or written with other fields.
    function legalAcceptanceEntryOk(after, before, docId) {
      return !(docId in after)
        || (docId in before && after[docId] == before[docId])
        || (after[docId] is map
            && after[docId].keys().hasOnly(['version', 'acceptedAt'])
            && after[docId].version is int
            && after[docId].version >= 1
            && after[docId].acceptedAt == request.time);
    }

    function legalAcceptanceOk(data, before) {
      return !('legalAcceptance' in data)
        || (data.legalAcceptance is map
            && data.legalAcceptance.keys().hasOnly(['terms_commuter', 'terms_conductor', 'privacy_policy'])
            && legalAcceptanceEntryOk(data.legalAcceptance, before, 'terms_commuter')
            && legalAcceptanceEntryOk(data.legalAcceptance, before, 'terms_conductor')
            && legalAcceptanceEntryOk(data.legalAcceptance, before, 'privacy_policy'));
    }

    // Users. Everyone reads their own profile. Operators read users on their
    // line, plus commuters (feedback / lost-item submitter emails). Privileges
    // (role, line) and the password-change bookkeeping are server-only: conductor
    // accounts are created/reset by Cloud Functions, and completePasswordChange
    // clears mustChangePassword. The NEX sign-up creates { email, role: "commuter",
    // createdAt, legalAcceptance }; users later add acceptances of new versions.
    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId
            || (isOperator()
                && (resource.data.role == 'commuter' || resource.data.line == callerProfile().line)));
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'commuter'
        && !('line' in request.resource.data)
        && !('mustChangePassword' in request.resource.data)
        && legalAcceptanceOk(request.resource.data, {});
      allow update: if
        // An operator may rename a conductor on their own line — nothing else.
        (operatorOnLine(resource.data.line)
          && request.auth.uid != userId
          && resource.data.role == 'conductor'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
        // Own profile: anything except privileges and password bookkeeping.
        || (signedIn()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'role', 'line', 'mustChangePassword', 'passwordChangedAt', 'passwordResetAt', 'createdBy'])
          && legalAcceptanceOk(request.resource.data, resource.data.get('legalAcceptance', {})));
      // accounts are deleted by the deleteConductor / deleteMyAccount functions
      allow delete: if false;
    }

    // Rate-limit doc for (user, route): written in the same batch as each
    // feedback. Updating it is only allowed 10 minutes after the last one.
    function rateLimitPath(routeId) {
      return /databases/$(database)/documents/feedback_rate_limits/$(request.auth.uid + '_' + routeId);
    }

    // Passenger feedback: commuters submit their own (validated, rate-limited);
    // only the author and operators can read it; operators review it.
    match /service_feedbacks/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 2000
        && request.resource.data.createdAt == request.time
        && (!('categories' in request.resource.data)
            || (request.resource.data.categories is list
                && request.resource.data.categories.size() <= 10))
        && request.resource.data.routeId is string
        && getAfter(rateLimitPath(request.resource.data.routeId)).data.lastAt == request.time;
      allow read: if operatorOnLine(resource.data.line)
        || (signedIn() && resource.data.userId == request.auth.uid);
      // Operators (of the feedback's line) may only change the review fields.
      allow update: if operatorOnLine(resource.data.line)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'operatorNote', 'statusUpdatedAt', 'statusUpdatedBy', 'statusUpdatedByEmail'])
        && request.resource.data.status in ['new', 'reviewed', 'resolved']
        && (!('operatorNote' in request.resource.data)
            || (request.resource.data.operatorNote is string
                && request.resource.data.operatorNote.size() <= 1000))
        && request.resource.data.statusUpdatedAt == request.time
        && request.resource.data.statusUpdatedBy == request.auth.uid;
      allow delete: if operatorOnLine(resource.data.line);
    }

    // One doc per (user, route): { uid, routeId, lastAt }. Key = "<uid>_<routeId>".
    match /feedback_rate_limits/{key} {
      allow read: if signedIn() && key.matches(request.auth.uid + '_.*');
      allow create: if signedIn()
        && key == request.auth.uid + '_' + request.resource.data.routeId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lastAt == request.time;
      allow update: if signedIn()
        && key == request.auth.uid + '_' + request.resource.data.routeId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lastAt == request.time
        && resource.data.lastAt < request.time - duration.value(10, 'm');
    }

    // Lost-item reports hold the reporter's name and phone: only the reporter
    // and operators can read them; only operators can update or delete them.
    match /lost_item_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.createdAt == request.time
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000
        && request.resource.data.contactName is string
        && request.resource.data.contactName.size() <= 100
        && request.resource.data.contactPhone is string
        && request.resource.data.contactPhone.size() <= 30;
      allow read: if operatorOnLine(resource.data.line)
        || (signedIn() && resource.data.userId == request.auth.uid);
      // Operators (of the report's line) may only change the resolution fields
      // — never what the commuter reported. `resolvedAt` drives photo retention.
      allow update: if operatorOnLine(resource.data.line)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'operatorNote', 'resolvedAt', 'statusUpdatedAt', 'statusUpdatedBy', 'statusUpdatedByEmail'])
        && request.resource.data.status in ['PENDING', 'FOUND', 'RETURNED', 'CLOSED']
        && (!('operatorNote' in request.resource.data)
            || (request.resource.data.operatorNote is string
                && request.resource.data.operatorNote.size() <= 1000))
        && (request.resource.data.status in ['RETURNED', 'CLOSED']
            ? request.resource.data.resolvedAt is timestamp
            : (!('resolvedAt' in request.resource.data) || request.resource.data.resolvedAt == null))
        && request.resource.data.statusUpdatedAt == request.time
        && request.resource.data.statusUpdatedBy == request.auth.uid;
      allow delete: if operatorOnLine(resource.data.line);
    }

    // Completed trips (NEX conductor app, buildTripObject → saveCompletedTrip).
    // A conductor may create only their own trip, on their own bus line; trips
    // are immutable afterwards. Only that conductor and the line's operators can read them.
    match /trips/{tripId} {
      allow create: if signedIn()
        && callerProfile().role == 'conductor'
        && request.resource.data.line == callerProfile().line
        && request.resource.data.conductorId == request.auth.uid
        && request.resource.data.tripId == tripId
        // 'inoperable' = the trip was cut short by Mark as Inoperable.
        && request.resource.data.status in ['completed', 'inoperable']
        // The bus must be a real `buses` doc, and busId must be its busNumber.
        && request.resource.data.busId is string
        && request.resource.data.busDocId is string
        && exists(/databases/$(database)/documents/buses/$(request.resource.data.busDocId))
        && get(/databases/$(database)/documents/buses/$(request.resource.data.busDocId)).data.busNumber
             == request.resource.data.busId
        // Times are Firestore Timestamps; createdAt is the server time.
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.arrivalTime is timestamp
        && request.resource.data.endTime >= request.resource.data.startTime
        && request.resource.data.endTime <= request.time + duration.value(5, 'm')
        && request.resource.data.createdAt == request.time
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds >= 0
        && request.resource.data.keys().hasOnly([
             'tripId', 'busId', 'busDocId', 'conductorId', 'routeId', 'route', 'line',
             'startTime', 'endTime', 'arrivalTime', 'createdAt', 'status',
             'durationSeconds', 'durationFormatted', 'totalDistanceKm', 'averageSpeedKmh',
             'startLatitude', 'startLongitude', 'endLatitude', 'endLongitude']);
      allow read: if operatorOnLine(resource.data.line)
        || (signedIn() && resource.data.conductorId == request.auth.uid);
      allow delete: if operatorOnLine(resource.data.line);
    }

    // Fleet buses. Everyone signed in can read them (the NEX app's vehicle
    // picker and trip saving need it); only operators manage the buses on
    // their own line. busNumber and line never change after creation: trips
    // (busDocId + busNumber) and live tracking (activeBuses/{busNumber}) key
    // on them.
    function busFieldsValid(data) {
      return data.plateNumber is string
        && data.plateNumber.size() >= 1 && data.plateNumber.size() <= 20
        && data.model is string
        && data.model.size() >= 1 && data.model.size() <= 60;
    }

    match /buses/{busId} {
      allow read: if signedIn();
      allow create: if operatorOnLine(request.resource.data.line)
        && request.resource.data.busNumber is string
        && request.resource.data.busNumber.size() >= 2
        && request.resource.data.busNumber.size() <= 20
        && busFieldsValid(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['busNumber', 'plateNumber', 'model', 'line', 'createdAt', 'updatedAt']);
      allow update: if operatorOnLine(resource.data.line)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plateNumber', 'model', 'updatedAt'])
        && busFieldsValid(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if operatorOnLine(resource.data.line);
    }

    // Push (FCM) tokens: { tokens: { <token>: { platform, updatedAt } }, updatedAt }.
    // Each user writes only their own doc; nobody can read tokens from a
    // client — only the Admin SDK (markBusInoperable) reads them to send pushes.
    match /push_tokens/{userId} {
      allow read: if false;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['tokens', 'updatedAt'])
        && request.resource.data.tokens is map
        && request.resource.data.tokens.size() <= 20;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Notify on Arrival watches (functions/arrivalWatches.js), id {uid}_{busId}:
    // a commuter's boarding point for one bus, kept only while the watch is
    // active. Created, notified and ended only by Cloud Functions (which
    // enforce the limits and measure the boarding point along the route). The
    // owner can read theirs and turn one off — status active → cancelled,
    // removing the boarding point; operators of the route's line can read
    // them for support.
    match /arrivalWatches/{watchId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
            || operatorOnLine(resource.data.line));
      allow create, delete: if false;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.endReason == 'user'
        && request.resource.data.endedAt == request.time
        && !('boardingPoint' in request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'endReason', 'endedAt', 'boardingPoint']);
    }

    // No catch-all: any collection not matched above is denied by default.
  }
}
