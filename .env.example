# Copy to .env and fill in with the NEX Firebase project values.
# Only VITE_-prefixed vars are exposed to the client bundle.

VITE_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for custom (Advanced Marker) pins. Falls back to DEMO_MAP_ID (dev only) when empty.
VITE_PUBLIC_GOOGLE_MAPS_MAP_ID=

VITE_PUBLIC_FIREBASE_API_KEY=
VITE_PUBLIC_FIREBASE_AUTH_DOMAIN=
VITE_PUBLIC_FIREBASE_PROJECT_ID=
VITE_PUBLIC_FIREBASE_DATABASE_URL=
VITE_PUBLIC_FIREBASE_STORAGE_BUCKET=
VITE_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
VITE_PUBLIC_FIREBASE_APP_ID=
VITE_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Web push (operator alerts when a bus is marked inoperable): Firebase console →
# Project settings → Cloud Messaging → Web Push certificates → key pair. Optional;
# without it the dashboard still shows inoperable buses, just no browser push.
VITE_PUBLIC_FIREBASE_VAPID_KEY=
